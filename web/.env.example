# Copy to .env.remote.local for npm run db:remote. On Vercel, set these in the project's env settings.
# Placeholders only. Never commit real values.

# Supabase transaction pooler (port 6543). Leave unset to use PGlite (local, or a temp dir on Vercel).
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres

# Google sign-in. Create an OAuth client (type Web application) in Google Cloud.
# Authorised redirect URI: https://<host>/api/auth/google/callback
# (and http://localhost:3100/api/auth/google/callback for local runs).
# Both must be set to turn it on. Set NICO_SESSION_SECRET (below) once real sign-in is on.
GOOGLE_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-client-secret

# 1 turns on the roster picker at /signin, for local runs and the open demo. With DATABASE_URL set it stays off
# unless NICO_ALLOW_DEMO_IN_HOSTED=1 (the same holds for NICO_OPEN_DEMO).
NICO_DEV_SIGNIN=1

# Long random strings. If unset on Vercel without DATABASE_URL, both are derived (synthetic data only).
# With DATABASE_URL set, both must be set: the app refuses a derived one.
NICO_SESSION_SECRET=replace-with-a-long-random-string
NICO_JOB_SECRET=replace-with-another-long-random-string
# Vercel sends it to the daily reminders cron (vercel.json).
CRON_SECRET=replace-with-a-third-long-random-string

# Only people with this email domain can sign in.
NICO_ALLOWED_DOMAIN=example.test
# Single addresses outside the domain that may sign in, comma-separated. Each must also be on the roster.
NICO_ALLOWED_EMAILS=

# 1 skips sign-in: a visitor with no session is the team lead, and /signin switches person. Synthetic data only.
NICO_OPEN_DEMO=1

# Jev (TypeSafe) reads notes and search queries to suggest a status and to rank search by meaning. Off unless set.
# Everything sent is masked first (lib/redact.ts): people, projects, emails, phones, links and amounts become labels.
# Names that are not on the roster pass through. List them in pilot/jev-terms.local.json (git-ignored), a JSON array of strings.
# NICO_JEV=1 plus a key turns it on. With DATABASE_URL set it stays off unless NICO_JEV_LIVE=1 as well.
NICO_JEV=
TYPESAFE_API_KEY=
NICO_JEV_LIVE=

# Google Meet notes as a source of minutes. Off unless NICO_MEET=1 and the Google client above is set.
# Enable the Meet REST API and Drive API, add the scopes meetings.space.readonly and drive.meet.readonly to the consent
# screen, and add the redirect URI https://<host>/api/auth/google/meet/callback
# (and http://localhost:3100/api/auth/google/meet/callback for local runs).
# NICO_TOKEN_KEY seals the saved refresh tokens. Required on Vercel and with DATABASE_URL. Keep it: losing it means
# each lead connects again.
NICO_MEET=
NICO_TOKEN_KEY=replace-with-a-long-random-string
