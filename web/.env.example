# Copy to .env.remote.local for npm run db:remote. On Vercel, set these in the project's env settings.
# Placeholders only. Never commit real values.

# Supabase transaction pooler (port 6543). Leave unset to use PGlite (local, or a temp dir on Vercel).
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres

# Google sign-in. Create an OAuth client (type Web application) in Google Cloud.
# Authorised redirect URI: https://<host>/api/auth/google/callback
# (and http://localhost:3100/api/auth/google/callback for local runs).
# Both must be set to turn it on. Set NICO_SESSION_SECRET (below) once real sign-in is on.
GOOGLE_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-client-secret

# 1 turns on the roster picker at /signin, for local runs and the open demo. Leave it off in production.
NICO_DEV_SIGNIN=1

# Long random strings. If unset on Vercel, both are derived from DATABASE_URL (fine for synthetic data only).
NICO_SESSION_SECRET=replace-with-a-long-random-string
NICO_JOB_SECRET=replace-with-another-long-random-string

# Only people with this email domain can sign in.
NICO_ALLOWED_DOMAIN=example.test
# Single addresses outside the domain that may sign in, comma-separated. Each must also be on the roster.
NICO_ALLOWED_EMAILS=

# 1 skips sign-in: a visitor with no session is the team lead, and /signin switches person. Synthetic data only.
NICO_OPEN_DEMO=1
