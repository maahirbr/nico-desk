# Supabase project URL. Setting it turns on hosted mode (Google sign-in). Leave it unset for local mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable key (public by design).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Postgres connection string, the Supabase transaction pooler (port 6543). Secret: set it in Vercel, never commit it.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
# Comma separated emails allowed to sign in.
ALLOWED_EMAILS=person@example.com
# Comma separated email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=example.com
